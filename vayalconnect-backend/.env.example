# ============================================================
# VayalConnect Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials.
# ============================================================

# Application
APP_ENV=development
APP_NAME=VayalConnect
APP_VERSION=1.1.0
DEBUG=true

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=vayalconnect

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brevo (Email OTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=vayalconnect@gmail.com
BREVO_SENDER_NAME=Vayal Connect

# Government Market Price API (data.gov.in)
GOVERNMENT_MARKET_API_KEY=your-data-gov-in-api-key
GOVERNMENT_MARKET_API_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Encryption (for bank details)
ENCRYPTION_KEY=your-fernet-encryption-key-base64

# Rate Limiting
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_OTP=5/hour
RATE_LIMIT_GENERAL=100/minute

# CORS
CORS_ORIGINS=["*"]

# Media Storage (future: Cloudinary/S3)
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_BASE_URL=/media

# Unpaid stock reservations and straight-line delivery assumptions
ORDER_RESERVATION_MINUTES=30
DELIVERY_SPEED_KMH=30
DELIVERY_DISTANCE_FACTOR=1.5
DELIVERY_PREPARATION_HOURS=24

# Market discovery: server only. Configure privately; never place this key in Flutter.
GEMINI_API_KEY=
GEMINI_MARKET_MODELS=gemini-3.8-flash
GEMINI_MARKET_TIMEOUT_SECONDS=60
GEMINI_MARKET_TOTAL_TIMEOUT_SECONDS=120
# Deprecated compatibility setting; daily discovery always sends at most one request.
GEMINI_MARKET_RETRIES=0
MARKET_CURRENT_MAX_DAYS=0
MARKET_CACHE_MAX_DAYS=7
MARKET_DAILY_REFRESH_ENABLED=false

# Active market provider. Never put the key in Flutter; rotate exposed keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MARKET_ENABLED=false
GROQ_TIMEOUT_SECONDS=60
GROQ_CONTEXT_TOKENS=131072
GROQ_MAX_COMPLETION_TOKENS=2048
# Set to your project's confirmed TPM/context budget; oversized batches stop.
GROQ_REQUEST_TOKEN_BUDGET=8000
MARKET_SOURCE_MAX_ROWS=5000
# Deprecated and ignored: a single OGD unit cannot cover all commodities.
GOVERNMENT_MARKET_UNIT=
# Reviewed HTTPS JSON feed endpoints with explicit original units (including flowers).
MARKET_SOURCE_URLS=[]

# Statewide deterministic primary-source workflow: remain off until staging verification.
MARKET_STATEWIDE_ENABLED=false
MARKET_SOURCE_VERIFIED=false
MARKET_STATEWIDE_MIN_OBSERVATIONS=3
