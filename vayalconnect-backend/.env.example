# ============================================================
# VayalConnect Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials.
# ============================================================

# Application
APP_ENV=development
APP_NAME=VayalConnect
APP_VERSION=1.0.0
DEBUG=true

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=vayalconnect

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brevo (Email OTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=vayalconnect@gmail.com
BREVO_SENDER_NAME=Vayal Connect

# Government Market Price API (data.gov.in)
GOVERNMENT_MARKET_API_KEY=your-data-gov-in-api-key
GOVERNMENT_MARKET_API_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Encryption (for bank details)
ENCRYPTION_KEY=your-fernet-encryption-key-base64

# Rate Limiting
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_OTP=5/hour
RATE_LIMIT_GENERAL=100/minute

# CORS
CORS_ORIGINS=["*"]

# Media Storage (future: Cloudinary/S3)
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_BASE_URL=/media
